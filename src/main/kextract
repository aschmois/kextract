#!/bin/sh
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)" || exit 1
LIBS="$ROOT/lib/org.graphiks.kextract.jar"
for jar in "$ROOT/lib/"*.jar; do
    case "$jar" in
        *org.graphiks.kextract*) ;;
        *) LIBS="$LIBS:$jar" ;;
    esac
done
if [ "$(uname -s)" = "Linux" ]; then
    RUNTIME_LIB="$ROOT/runtime/lib"
    LIBJSIG="$RUNTIME_LIB/libjsig.so"
    if [ ! -f "$LIBJSIG" ]; then
        printf 'kextract: required Linux signal-chaining library not found: %s\n' "$LIBJSIG" >&2
        exit 1
    fi
    LD_LIBRARY_PATH="$RUNTIME_LIB${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    LD_PRELOAD="libjsig.so${LD_PRELOAD:+:$LD_PRELOAD}"
    export LD_LIBRARY_PATH LD_PRELOAD
fi
exec "$ROOT/runtime/bin/java" $JEXTRACT_JAVA_OPTIONS \
  --enable-native-access=ALL-UNNAMED \
  -Djava.library.path="$ROOT/lib" \
  -cp "$LIBS" \
  org.graphiks.kextract.pipeline.KextractTool "$@"
